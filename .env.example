# Database (SQLite — drizzle-kit + api)
DATABASE_URL="file:./chirp.db"

# gRPC server
GRPC_PORT="50051"
GRPC_API_HOST="localhost"

# HTTP health/gateway port (api /health)
HTTP_PORT="3001"

# Secrets — generate your own; do NOT reuse these in production
GRPC_JWT_SECRET="dev-jwt-secret-change-me"
SESSION_SECRET="dev-session-secret-change-me"
