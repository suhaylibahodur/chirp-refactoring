# Chirp API environment variables

# Shared secret used to sign/verify the short-lived gRPC session JWTs.
# REQUIRED — the server fails to start if this is unset or shorter than 32 chars.
# There is no default: generate a strong random value, e.g. `openssl rand -base64 48`,
# and set the SAME value on the client apps (client-user, client-admin).
GRPC_JWT_SECRET=

# SQLite/libSQL connection string.
DATABASE_URL=file:./chirp.db

# Ports.
GRPC_PORT=50051
HTTP_PORT=3001
